<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      allowBackup=false：这个 App 的承诺是「数据没有可去的地方」，而云备份与换机迁移正是两条
      「数据自己走去别处」的路径。可备份的内容里全是要紧的：Cookie 授权记录与引擎地址
      （shared_prefs/bgv_cookie、bgv_engine、bgv_output）、历史记录库（browseguard.db），
      以及 WebView 自己的 CookieStore（app_webview/ 下的加密域文件，落在 database/file 备份域里）。
      用 <exclude> 一条条排除也可以，但清单得人工跟着新增文件跑——漏一个就是一个静默泄漏，
      与项目「不静默降级」的规矩冲突，所以整条通道关死。
      代价（登记在验收报告）：换机后设置、引擎地址、Cookie 授权、历史记录从零开始；
      已下载的产物在 Download 目录与 SAF 所选文件夹里，不受影响。
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrowseGuardVid">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
