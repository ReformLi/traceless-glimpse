<?xml version="1.0" encoding="utf-8"?>
<!--
  内置浏览器要打开用户自己输入的任意站点：很多视频站与媒体 CDN 仍是 HTTP，
  只放行回环会让 M7「纯手机模式」在第一步就失败。因此全局允许明文。

  代价与边界：
  - 地址栏对 http:// 页面显示「不安全」提示，用户知道自己在明文上；
  - 电脑引擎仍由 EngineSettings 校验（非回环默认 HTTPS），这条开关只服务网页浏览；
  - 下载器只访问用户点选的那条媒体 URL，不做域名枚举。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
